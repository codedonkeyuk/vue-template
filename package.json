{
  "name": "spa-template",
  "version": "0.0.1",
  "description": "A basic JavaScript SPA template project.",
  "homepage": "https://github.com/codedonkeyuk/spa-template#readme",
  "bugs": {
    "url": "https://github.com/codedonkeyuk/spa-templateissues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.comcodedonkeyuk/spa-template.git"
  },
  "license": "MIT",
  "author": "Leigh",
  "type": "module",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "clean": "prettier . --write",
    "validate": "prettier . --check && tsc --noEmit && npx cspell README.md",
    "dev": "vite",
    "serveDev": "vite --open",
    "serveProd": "vite preview --open",
    "prebuild": "prettier . --check && tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "canvas": "^3.2.3",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "glob": "^13.0.6",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.8",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true,
    "canvas@3.2.3": true
  }
}
